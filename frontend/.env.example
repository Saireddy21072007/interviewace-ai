# Where the API lives.
#
# Leave this unset in development: Vite proxies /api to http://127.0.0.1:8000
# (see vite.config.ts), which keeps the browser on one origin and avoids CORS.
#
# For a deployed build, point it at the real backend:
#   VITE_API_URL=https://interviewace-api.onrender.com
# VITE_API_URL=
