# ==========================================================================
# InterviewAce AI - environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# Every value below has a safe default, so the app runs even if you skip it.
# ==========================================================================

# --- Security -------------------------------------------------------------
# Used to sign JWTs. Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database -------------------------------------------------------------
# Default is SQLite so the project runs with zero setup.
# For the PostgreSQL setup described in the project guide, use:
#   DATABASE_URL=postgresql+psycopg://interviewace:secret@localhost:5432/interviewace
DATABASE_URL=sqlite:///./interviewace.db

# --- AI provider ----------------------------------------------------------
# LLM_PROVIDER: auto | anthropic | openai | gemini | offline
#   auto    -> use whichever API key is present (anthropic > openai > gemini),
#              and fall back to the built-in offline engine if none are.
#   offline -> force the deterministic template engine (no network, no cost).
LLM_PROVIDER=auto
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Speech-to-text -------------------------------------------------------
# STT_PROVIDER: auto | faster-whisper | openai-whisper | none
#   auto -> use faster-whisper if installed, else fall back to the transcript
#           the browser's Web Speech API already produced.
STT_PROVIDER=auto
WHISPER_MODEL=base.en

# --- Storage --------------------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# --- CORS -----------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Admin bootstrap ------------------------------------------------------
# The first account registered with this email is automatically an admin.
ADMIN_EMAIL=admin@interviewace.ai
